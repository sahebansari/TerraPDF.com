  <section class="showcase-section home-simple-showcase home-ai-agents" aria-labelledby="home-ai-title">
    <div class="container">
      <div class="section-header">
        <h2 id="home-ai-title">Or let an AI agent build the PDF</h2>
        <p>Ask for a document in plain language. The agent describes it as JSON and calls TerraPDF&rsquo;s <code>create_pdf</code> tool, which validates it, renders it, and returns the file. Mistakes come back with exact JSON paths, so the agent fixes them itself.</p>
      </div>

      <div class="showcase-panel">
        <div class="showcase-code">
          <div class="code-titlebar">
            <span class="dots" aria-hidden="true"><span></span><span></span><span></span></span>
            create_pdf &middot; written by the agent
            <a class="code-titlebar-link" href="/docs/create-pdfs-with-ai/">Step-by-step guide &rarr;</a>
          </div>
          <pre class="showcase-pre"><code class="language-json">{
  "title": "Q3 Sales Summary",
  "page": { "size": "A5", "margin": 34 },
  "theme": { "accentColor": "#1A3C5E", "fontSize": 9 },
  "content": [
    { "type": "heading", "level": 1, "text": "Q3 Sales Summary" },
    { "type": "paragraph",
      "text": "Revenue grew **18%** quarter over quarter, led by *EMEA*." },
    { "type": "chart", "chartType": "bar", "height": 150,
      "labels": ["NA", "EMEA", "APAC", "LATAM"],
      "series": [
        { "name": "Q2", "values": [410, 380, 190, 60] },
        { "name": "Q3", "values": [430, 455, 240, 75] } ] },
    { "type": "table",
      "columns": [
        { "header": "Region", "width": 2 },
        { "header": "Q3 revenue", "align": "right" },
        { "header": "Change", "align": "right" } ],
      "rows": [
        ["North America", "$430k", "+4.9%"],
        ["EMEA", "$455k", "+19.7%"],
        ["APAC", "$240k", "+26.3%"],
        ["LATAM", "$75k", "+25.0%"] ],
      "footerRows": [["Total", "$1.2M", "+15.4%"]] },
    { "type": "callout", "title": "Next step",
      "text": "Expand the APAC channel team in Q4." }
  ]
}</code></pre>
