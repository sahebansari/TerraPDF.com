          <tr><td><code>Unit.Centimetre</code></td><td>1 cm ≈ 28.35 points</td><td><code>.Margin(2, Unit.Cm)</code></td></tr>
          <tr><td><code>Unit.Inch</code></td><td>1 inch = 72 points</td><td><code>.Margin(1, Unit.Inch)</code></td></tr>
