<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Security: GitHub Pages cannot send HTTP headers, so CSP ships as a meta tag.
       'unsafe-inline' is needed for style only (inline style attributes); all scripts are external. -->
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://img.shields.io https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  {% set defaultKeywords = 'C# PDF library, .NET PDF library, .NET PDF generator, PDF generation in C#, create PDF in C#, generate PDF C#, PDF document generation, open source PDF library, free C# PDF library, NuGet PDF package, fluent PDF API, code-first PDF generation, PDF layout engine, PDF reports, invoice PDF generation, PDF tables, PDF images, PDF bookmarks, PDF metadata, PDF encryption, AES-256 PDF, pure C# PDF, zero dependency PDF library, ASP.NET Core PDF generation, TerraPDF' %}
  
  <!-- Primary Meta Tags -->
  <title>{{ title }}</title>
  <meta name="title" content="{{ title }}">
  <meta name="description" content="{{ description or 'TerraPDF is a lightweight, zero-dependency, pure C# library for generating professional PDF 1.7 documents. Fast, free, and easy to use.' }}">
  <meta name="keywords" content="{{ keywords or defaultKeywords }}">
  <meta name="author" content="Saheb Ansari">
  <meta name="robots" content="{{ robots or 'index, follow' }}">
  <meta name="theme-color" content="#0f172a">
  {% set resolvedCanonicalUrl = canonicalUrl or 'https://terrapdf.com' + page.url %}
  
  <!-- Canonical URL -->
  <link rel="canonical" href="{{ resolvedCanonicalUrl }}">
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:locale" content="en_US">
  <meta property="og:url" content="{{ resolvedCanonicalUrl }}">
  <meta property="og:title" content="{{ title }} | TerraPDF">
  <meta property="og:description" content="{{ description or 'TerraPDF - A lightweight, zero-dependency, pure C# library for generating professional PDF documents. Fast, free, and easy to use.' }}">
  <meta property="og:image" content="https://terrapdf.com/images/tp-logo.png">
  <meta property="og:image:alt" content="TerraPDF PDF generation library logo">
  <meta property="og:site_name" content="TerraPDF">
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="{{ resolvedCanonicalUrl }}">
  <meta name="twitter:title" content="{{ title }} | TerraPDF">
  <meta name="twitter:description" content="{{ description or 'TerraPDF - A lightweight, zero-dependency, pure C# library for generating professional PDF documents.' }}">
  <meta name="twitter:image" content="https://terrapdf.com/images/tp-logo.png">
  <meta name="twitter:image:alt" content="TerraPDF logo">
  
    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon/android-chrome-192x192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/images/favicon/android-chrome-512x512.png">
    <link rel="manifest" href="/images/favicon/site.webmanifest">

   <!-- Fonts: self-hosted Inter & JetBrains Mono (variable, latin + latin-ext) -->
   <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>

    <!-- Stylesheets -->
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/vendor/atom-one-light.min.css">

    <!-- Scripts: all external and deferred (CSP allows no inline scripts) -->
    <script src="/js/vendor/highlight.min.js" defer></script>
    <script src="/js/main.js" defer></script>

<!-- Google tag (gtag.js) — cookieless: Consent Mode defaults (set in analytics.js)
     deny all storage, so no analytics or advertising cookies are ever set. See /privacy/. -->
<script src="/js/analytics.js"></script>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-RZQ8PWHNLP"></script>
  
  <!-- Structured Data / JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "TerraPDF",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Windows, Linux, macOS",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "A lightweight, zero-dependency, pure C# library for generating professional PDFs with layout, tables, images, links, bookmarks, vector graphics, WinAnsi text, and AES-256 encryption.",
    "keywords": "{{ keywords or defaultKeywords }}",
    "url": "https://github.com/sahebansari/TerraPDF",
    "downloadUrl": "https://www.nuget.org/packages/TerraPDF/",
    "screenshot": "https://terrapdf.com/images/tp-logo.png",
    "sameAs": ["https://github.com/sahebansari/TerraPDF"],
    "author": {
      "@type": "Person",
      "name": "Saheb Ansari"
    },
    "softwareVersion": "{{ site.version }}",
    "programmingLanguage": "C#",
    "targetPlatform": ".NET 8, .NET 9, .NET 10",
    "license": "https://github.com/sahebansari/TerraPDF/blob/master/LICENSE"
  }
  </script>
</head>
<body>
  <header class="site-header">
    <div class="header-license-bar">
      <div class="container header-license-inner">
        <span class="header-license-mark">MIT</span>
        <strong>Free for personal and commercial use.</strong>
        <span>No licensing fees for private or commercial .NET apps.</span>
        <a href="https://github.com/sahebansari/TerraPDF/blob/master/LICENSE" target="_blank" rel="noopener nofollow noreferrer">License</a>
      </div>
    </div>
    <nav class="container nav-wrapper" aria-label="Main navigation">
      <a href="/" class="logo">
        <img src="/images/tp-logo.png" alt="TerraPDF Logo" class="logo-img">
        <span class="logo-text"></span>
      </a>
      <ul class="nav-links">
        <li><a href="/" {% if page.url | isActiveNav("/") %}class="active" aria-current="page"{% endif %}>Home</a></li>
        <li><a href="/features/" {% if page.url | isActiveNav("/features/") %}class="active" aria-current="page"{% endif %}>Features</a></li>
        <li><a href="/getting-started/" {% if page.url | isActiveNav("/getting-started/") %}class="active" aria-current="page"{% endif %}>Getting Started</a></li>
        <li><a href="/docs/" {% if page.url | isActiveNav("/docs/") %}class="active" aria-current="page"{% endif %}>Documentation</a></li>
        <li><a href="/samples/" {% if page.url | isActiveNav("/samples/") %}class="active" aria-current="page"{% endif %}>Samples</a></li>
        <li><a href="/enterprise/" {% if page.url | isActiveNav("/enterprise/") %}class="active" aria-current="page"{% endif %}>Enterprise</a></li>
        <li><a href="/download/" {% if page.url | isActiveNav("/download/") %}class="active" aria-current="page"{% endif %}>Download</a></li>
      </ul>
      <div class="nav-cta">
        <a href="https://github.com/sahebansari/TerraPDF" class="btn btn-outline" target="_blank" rel="noopener nofollow noreferrer">GitHub</a>
        <a href="https://www.nuget.org/packages/TerraPDF/" class="btn btn-primary" target="_blank" rel="noopener nofollow noreferrer">NuGet</a>
      </div>
      <button type="button" class="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-links">&#x2630;</button>
    </nav>    
  </header>

    <main id="main-content">
      {% if docPage %}
        {% set current = null %}
        {% for item in docsNavFlat %}
          {% if item.url == page.url %}
            {% set current = item %}
          {% endif %}
        {% endfor %}

        <div class="container docs-layout">
          <button type="button" class="docs-sidebar-toggle" aria-expanded="false" aria-controls="docs-sidebar">
            <span aria-hidden="true">☰</span> Browse Documentation
          </button>

          <nav class="docs-sidebar" id="docs-sidebar" aria-label="Documentation navigation">
            <a href="/docs/" class="docs-sidebar-home {% if page.url == '/docs/' %}active{% endif %}">📚 Documentation Home</a>
            {% for group in docsNav %}
              <div class="docs-sidebar-group">
                <p class="docs-sidebar-group-title">{{ group.group }}</p>
                <ul class="docs-sidebar-list">
                  {% for item in group.items %}
                    <li>
                      <a href="{{ item.url }}" class="docs-sidebar-link{% if item.url == page.url %} active{% endif %}"{% if item.url == page.url %} aria-current="page"{% endif %}>
                        <span class="docs-sidebar-icon" aria-hidden="true">{{ item.icon }}</span>{{ item.title }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endfor %}
          </nav>

          <div class="docs-main content-section">
            {{ content | safe }}

            {% if current and (current.prev or current.next) %}
              <div class="docs-page-nav">
                {% if current.prev %}
                  <a href="{{ current.prev.url }}" class="docs-nav-link docs-nav-prev">← {{ current.prev.title }}</a>
                {% endif %}
                {% if current.next %}
                  <a href="{{ current.next.url }}" class="docs-nav-link docs-nav-next">{{ current.next.title }} →</a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      {% else %}
        {{ content | safe }}
      {% endif %}
    </main>

    <footer class="site-footer">
    <div class="container footer-content">
      <div class="footer-section">
        <div class="footer-logo">
          <img src="/images/tp-logo.png" alt="TerraPDF Logo" class="footer-logo-img">
          <h4>TerraPDF</h4>
        </div>
        <p>A lightweight, zero-dependency, pure C# library for generating professional PDF documents.</p>
      </div>
      <div class="footer-section">
        <h4>Quick Links</h4>
        <ul>
          <li><a href="/features/">Features</a></li>
          <li><a href="/getting-started/">Getting Started</a></li>
          <li><a href="/docs/">Documentation</a></li>
          <li><a href="/samples/">Samples</a></li>
          <li><a href="/enterprise/">Enterprise</a></li>
          <li><a href="/faq/">FAQ</a></li>
          <li><a href="https://github.com/sahebansari/TerraPDF" rel="noopener nofollow noreferrer">GitHub Repository</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h4>Resources</h4>
        <ul>
          <li><a href="https://www.nuget.org/packages/TerraPDF/" rel="noopener nofollow noreferrer">NuGet Package</a></li>
          <li><a href="https://github.com/sahebansari/TerraPDF/tree/master/docs" rel="noopener nofollow noreferrer">Full Documentation</a></li>
          <li><a href="https://github.com/sahebansari/TerraPDF/issues" rel="noopener nofollow noreferrer">Report an Issue</a></li>
          <li><a href="https://github.com/sahebansari/TerraPDF/blob/master/CONTRIBUTING.md" rel="noopener nofollow noreferrer">Contributing</a></li>
          <li><a href="/changelog/">Changelog</a></li>
          <li><a href="/security/">Security Policy</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h4>License &amp; Legal</h4>
        <p>MIT License &mdash; Free for commercial and personal use.</p>
        <ul>
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/legal/">Legal</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
    </div>
     <div class="footer-bottom">
        <div class="container">
          <p>&copy; {{ buildYear }} TerraPDF. Released under the <a href="https://github.com/sahebansari/TerraPDF/blob/master/LICENSE" rel="noopener nofollow noreferrer">MIT License</a>.</p>
          <p class="footer-signature">Designed with ❤️ by <a href="https://sahebansari.com" target="_blank" rel="noopener noreferrer">Saheb Ansari</a></p>
        </div>
      </div>
   </footer>
</body>
</html>
