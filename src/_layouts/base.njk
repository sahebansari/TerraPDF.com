<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% set defaultKeywords = 'C# PDF library, .NET PDF library, .NET PDF generator, PDF generation in C#, create PDF in C#, generate PDF C#, PDF document generation, open source PDF library, free C# PDF library, NuGet PDF package, fluent PDF API, code-first PDF generation, PDF layout engine, PDF reports, invoice PDF generation, PDF tables, PDF images, PDF bookmarks, PDF metadata, PDF encryption, AES-128 PDF, pure C# PDF, zero dependency PDF library, ASP.NET Core PDF generation, TerraPDF' %}
  
  <!-- Primary Meta Tags -->
  <title>{{ title }}</title>
  <meta name="title" content="{{ title }}">
  <meta name="description" content="{{ description or 'TerraPDF is a lightweight, zero-dependency, pure C# library for generating professional PDF 1.7 documents. Fast, free, and easy to use.' }}">
  <meta name="keywords" content="{{ keywords or defaultKeywords }}">
  <meta name="author" content="Saheb Ansari">
  <meta name="robots" content="{{ robots or 'index, follow' }}">
  <meta name="theme-color" content="#0f172a">
  {% set resolvedCanonicalUrl = canonicalUrl or 'https://terrapdf.com' + page.url %}
  
  <!-- Canonical URL -->
  <link rel="canonical" href="{{ resolvedCanonicalUrl }}">
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:locale" content="en_US">
  <meta property="og:url" content="{{ resolvedCanonicalUrl }}">
  <meta property="og:title" content="{{ title }} | TerraPDF">
  <meta property="og:description" content="{{ description or 'TerraPDF - A lightweight, zero-dependency, pure C# library for generating professional PDF documents. Fast, free, and easy to use.' }}">
  <meta property="og:image" content="https://terrapdf.com/images/tp-logo.png">
  <meta property="og:image:alt" content="TerraPDF PDF generation library logo">
  <meta property="og:site_name" content="TerraPDF">
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="{{ resolvedCanonicalUrl }}">
  <meta name="twitter:title" content="{{ title }} | TerraPDF">
  <meta name="twitter:description" content="{{ description or 'TerraPDF - A lightweight, zero-dependency, pure C# library for generating professional PDF documents.' }}">
  <meta name="twitter:image" content="https://terrapdf.com/images/tp-logo.png">
  <meta name="twitter:image:alt" content="TerraPDF logo">
  
    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon/android-chrome-192x192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/images/favicon/android-chrome-512x512.png">
    <link rel="manifest" href="/images/favicon/site.webmanifest">

   <!-- Google Fonts - Modern font stack -->
   <link rel="preconnect" href="https://fonts.googleapis.com">
   <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
   <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Stylesheets -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">

   <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script src="/js/main.js" defer></script>

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-RZQ8PWHNLP"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-RZQ8PWHNLP');
</script>
  
  <!-- Structured Data / JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "TerraPDF",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Windows, Linux, macOS",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "A lightweight, zero-dependency, pure C# library for generating professional PDFs with layout, tables, images, links, bookmarks, vector graphics, WinAnsi text, and AES-128 encryption.",
    "keywords": "{{ keywords or defaultKeywords }}",
    "url": "https://github.com/sahebansari/TerraPDF",
    "downloadUrl": "https://www.nuget.org/packages/TerraPDF/",
    "screenshot": "https://terrapdf.com/images/tp-logo.png",
    "sameAs": ["https://github.com/sahebansari/TerraPDF"],
    "author": {
      "@type": "Person",
      "name": "Saheb Ansari"
    },
    "softwareVersion": "1.3.0",
    "programmingLanguage": "C#",
    "targetPlatform": ".NET 8, .NET 9",
    "license": "https://github.com/sahebansari/TerraPDF/blob/master/LICENSE"
  }
  </script>
</head>
<body>
  <!-- Skip link for keyboard navigation -->
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <header class="site-header">
    <div class="header-license-bar" aria-label="TerraPDF licensing">
      <div class="container header-license-inner">
        <span class="header-license-mark">MIT</span>
        <strong>Free for personal and commercial use.</strong>
        <span>No licensing fees for private or commercial .NET apps.</span>
        <a href="https://github.com/sahebansari/TerraPDF/blob/master/LICENSE" target="_blank" rel="noopener nofollow noreferrer">License</a>
      </div>
    </div>
    <nav class="container nav-wrapper" aria-label="Main navigation" role="navigation">
      <a href="/" class="logo">
        <img src="/images/tp-logo.png" alt="TerraPDF Logo" class="logo-img">
        <span class="logo-text"></span>
      </a>
      <ul class="nav-links">
        <li><a href="/" {% if page.url | isActiveNav("/") %}class="active" aria-current="page"{% endif %}>Home</a></li>
        <li><a href="/features/" {% if page.url | isActiveNav("/features/") %}class="active" aria-current="page"{% endif %}>Features</a></li>
        <li><a href="/getting-started/" {% if page.url | isActiveNav("/getting-started/") %}class="active" aria-current="page"{% endif %}>Getting Started</a></li>
        <li><a href="/docs/" {% if page.url | isActiveNav("/docs/") %}class="active" aria-current="page"{% endif %}>Documentation</a></li>
        <li><a href="/samples/" {% if page.url | isActiveNav("/samples/") %}class="active" aria-current="page"{% endif %}>Samples</a></li>
        <li><a href="/download/" {% if page.url | isActiveNav("/download/") %}class="active" aria-current="page"{% endif %}>Download</a></li>
      </ul>
      <div class="nav-cta">
        <a href="https://github.com/sahebansari/TerraPDF" class="btn btn-outline" target="_blank" rel="noopener nofollow noreferrer">GitHub</a>
        <a href="https://www.nuget.org/packages/TerraPDF/" class="btn btn-primary" target="_blank" rel="noopener nofollow noreferrer">NuGet</a>
      </div>
      <button class="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-links">&#x2630;</button>
    </nav>    
  </header>

    <main id="main-content" role="main">
      {% if docPage %}
        <div class="container">
          <div class="content-section">
            <div class="docs-page-actions">
              <a href="/docs/" class="back-to-docs">← All Documentation</a>
              {% set docsNav = [
                {url: '/docs/getting-started/', title: 'Getting Started', next: '/docs/encryption/', nextTitle: 'Encryption & Security'},
                {url: '/docs/encryption/', title: 'Encryption & Security', prev: '/docs/getting-started/', prevTitle: 'Getting Started', next: '/docs/vector-graphics/', nextTitle: 'Vector Graphics'},
                {url: '/docs/vector-graphics/', title: 'Vector Graphics', prev: '/docs/encryption/', prevTitle: 'Encryption & Security', next: '/docs/unicode-and-encoding/', nextTitle: 'Unicode & Encoding'},
                {url: '/docs/unicode-and-encoding/', title: 'Unicode & Encoding', prev: '/docs/vector-graphics/', prevTitle: 'Vector Graphics', next: '/docs/text-and-spans/', nextTitle: 'Text & Spans'},
                {url: '/docs/text-and-spans/', title: 'Text & Spans', prev: '/docs/unicode-and-encoding/', prevTitle: 'Unicode & Encoding', next: '/docs/layout/', nextTitle: 'Layout'},
                {url: '/docs/layout/', title: 'Layout', prev: '/docs/text-and-spans/', prevTitle: 'Text & Spans', next: '/docs/decorators/', nextTitle: 'Decorators'},
                {url: '/docs/decorators/', title: 'Decorators', prev: '/docs/layout/', prevTitle: 'Layout', next: '/docs/images/', nextTitle: 'Images'},
                {url: '/docs/images/', title: 'Images', prev: '/docs/decorators/', prevTitle: 'Decorators', next: '/docs/table-of-contents/', nextTitle: 'Table of Contents'},
                {url: '/docs/table-of-contents/', title: 'Table of Contents', prev: '/docs/images/', prevTitle: 'Images', next: '/docs/bookmarks/', nextTitle: 'Bookmarks'},
                {url: '/docs/bookmarks/', title: 'Bookmarks', prev: '/docs/table-of-contents/', prevTitle: 'Table of Contents', next: '/docs/metadata/', nextTitle: 'Metadata'},
                {url: '/docs/metadata/', title: 'Metadata', prev: '/docs/bookmarks/', prevTitle: 'Bookmarks', next: '/docs/colors/', nextTitle: 'Colors'},
                {url: '/docs/colors/', title: 'Colors', prev: '/docs/metadata/', prevTitle: 'Metadata', next: '/docs/page-sizes-and-units/', nextTitle: 'Page Sizes & Units'},
                {url: '/docs/page-sizes-and-units/', title: 'Page Sizes & Units', prev: '/docs/colors/', prevTitle: 'Colors', next: '/docs/components-and-templates/', nextTitle: 'Components & Templates'},
                {url: '/docs/components-and-templates/', title: 'Components & Templates', prev: '/docs/page-sizes-and-units/', prevTitle: 'Page Sizes & Units', next: '/docs/row-and-column-layout/', nextTitle: 'Row & Column Layout'},
                {url: '/docs/row-and-column-layout/', title: 'Row & Column Layout', prev: '/docs/components-and-templates/', prevTitle: 'Components & Templates'}
              ] %}
              {% set current = null %}
              {% for item in docsNav %}
                {% if item.url == page.url %}
                  {% set current = item %}
                {% endif %}
              {% endfor %}
            </div>

            {{ content | safe }}

            {% if current and (current.prev or current.next) %}
              <div class="docs-page-nav">
                {% if current.prev %}
                  <a href="{{ current.prev }}" class="docs-nav-link docs-nav-prev">← {{ current.prevTitle }}</a>
                {% endif %}
                {% if current.next %}
                  <a href="{{ current.next }}" class="docs-nav-link docs-nav-next">{{ current.nextTitle }} →</a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      {% else %}
        {{ content | safe }}
      {% endif %}
    </main>

    <footer class="site-footer" role="contentinfo">
    <div class="container footer-content">
      <div class="footer-section">
        <div class="footer-logo">
          <img src="/images/tp-logo.png" alt="TerraPDF Logo" class="footer-logo-img">
          <h4>TerraPDF</h4>
        </div>
        <p>A lightweight, zero-dependency, pure C# library for generating professional PDF documents.</p>
      </div>
      <div class="footer-section">
        <h4>Quick Links</h4>
        <ul>
          <li><a href="/features/">Features</a></li>
          <li><a href="/getting-started/">Getting Started</a></li>
          <li><a href="/docs/">Documentation</a></li>
          <li><a href="/samples/">Samples</a></li>
          <li><a href="https://github.com/sahebansari/TerraPDF" rel="noopener nofollow noreferrer">GitHub Repository</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h4>Resources</h4>
        <ul>
          <li><a href="https://www.nuget.org/packages/TerraPDF/" rel="noopener nofollow noreferrer">NuGet Package</a></li>
          <li><a href="https://github.com/sahebansari/TerraPDF/tree/master/docs" rel="noopener nofollow noreferrer">Full Documentation</a></li>
          <li><a href="https://github.com/sahebansari/TerraPDF/issues" rel="noopener nofollow noreferrer">Report an Issue</a></li>
          <li><a href="https://github.com/sahebansari/TerraPDF/blob/master/CONTRIBUTING.md" rel="noopener nofollow noreferrer">Contributing</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h4>License</h4>
        <p>MIT License &mdash; Free for commercial and personal use.</p>
      </div>
    </div>
     <div class="footer-bottom">
        <div class="container">
          <p>&copy; {{ page.date.getFullYear() }} TerraPDF. All rights reserved. | <a href="https://github.com/sahebansari/TerraPDF/blob/master/LICENSE" rel="noopener nofollow noreferrer">MIT License</a></p>
          <p class="footer-signature">Designed with ❤️ by <a href="https://www.sahebansari.com" target="_blank" rel="noopener noreferrer">Saheb Ansari</a></p>
        </div>
      </div>
   </footer>
  <script>
    (function() {
      const menuToggle = document.querySelector('.mobile-menu-toggle');
      const navLinks = document.querySelector('.nav-links');
      if (!menuToggle || !navLinks) return;

      // Toggle menu on button click
      menuToggle.addEventListener('click', function() {
        const isExpanded = this.getAttribute('aria-expanded') === 'true';
        this.setAttribute('aria-expanded', !isExpanded);
        navLinks.classList.toggle('active');
      });

      // Close menu when clicking a link
      navLinks.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          navLinks.classList.remove('active');
          menuToggle.setAttribute('aria-expanded', 'false');
        });
      });

      // Close menu when clicking outside
      document.addEventListener('click', function(e) {
        if (!menuToggle.contains(e.target) && !navLinks.contains(e.target)) {
          navLinks.classList.remove('active');
          menuToggle.setAttribute('aria-expanded', 'false');
        }
      });

      // Close menu on Escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && navLinks.classList.contains('active')) {
          navLinks.classList.remove('active');
          menuToggle.setAttribute('aria-expanded', 'false');
          menuToggle.focus();
        }
      });
    })();
  </script>
</body>
</html>
