{
  "name": "terrapdf-com",
  "version": "1.0.0",
  "description": "TerraPDF.com static site",
  "scripts": {
    "start": "eleventy --serve",
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\"",
    "build": "npm run clean && eleventy",
    "test": "npm run build && html-validate \"_site/**/*.html\" && node scripts/check-internal-links.js",
    "watch": "eleventy --watch",
    "debug": "DEBUG=Eleventy* eleventy"
  },
  "keywords": [
    "csharp-pdf-library",
    "dotnet-pdf-generator",
    "pdf-generation",
    "create-pdf-csharp",
    "generate-pdf-csharp",
    "open-source-pdf",
    "nuget",
    "terrapdf"
  ],
  "author": "Saheb Ansari",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "html-validate": "^8.29.0"
  }
}
